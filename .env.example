DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_TIMEOUT_SECONDS=45

# Environment: production|integration require PostgreSQL; test allows SQLite;
# dev recommends PostgreSQL and requires MAS_ALLOW_SQLITE_DEV=true for SQLite.
# In production, DATA_MODE defaults to live and local fallback defaults to disabled.
APP_ENV=dev
MAS_API_KEY=
# Local recommended runtime: PostgreSQL via Docker Compose (MAS_DATABASE_URL below).
# Unit tests use APP_ENV=test + SQLite (see scripts/run_tests.py).
# MAS_ALLOW_SQLITE_DEV=true

# Data contract: demo allows SAMPLE_FINANCIAL_DATA; live disables silent sample fundamentals.
# demo = allow SAMPLE_FINANCIAL_DATA; live = PDF/live sources only
DATA_MODE=live
# When live (default true): fetch Yahoo annual income-statement fundamentals if no upload metrics
MAS_FETCH_LIVE_FUNDAMENTALS=true
# Prefer SEC EDGAR companyfacts for US tickers (falls back to Yahoo on miss)
MAS_FETCH_SEC_FUNDAMENTALS=true
# Required when APP_ENV is not dev/test: SEC fair-access User-Agent with operator contact.
# (also used when caching company_tickers.json for arbitrary-company ticker resolve)
# SEC_USER_AGENT=LumenFinAgent/0.1 (yourname@example.com)

# When unset: allowed in dev/test, disabled in production. Set true only for explicit demos.
# ALLOW_LOCAL_FALLBACK=false

# Upload limits
MAS_MAX_UPLOAD_BYTES=20971520
MAS_MAX_UPLOAD_FILES=5

# ---------------------------------------------------------------------------
# RAG profile (showcase / real PDF) — recommended local defaults
# Unit tests + GitHub Actions force sync_on_run + deterministic via
# scripts/run_tests.py and .github/workflows/test.yml (see lumenfin.rag.profiles).
# Deferred: Milvus Server / Redis index worker / model rerank (multi-worker only).
# ---------------------------------------------------------------------------
# Milvus Lite: single-process only — do not share one Lite file across API+CLI+worker.
# MAS_MILVUS_ISOLATE=true → data/milvus_lite_*_p{PID}.db to avoid lock errors.
MAS_RAG_ENABLED=true
MAS_RAG_INDEX_MODE=async_on_upload
MAS_EMBEDDING_PROVIDER=dashscope
MAS_EMBEDDING_DIMENSION=1024
MAS_MILVUS_URI=data/milvus_lite_dashscope.db
MAS_MILVUS_COLLECTION=lumenfin_chunks_ds
MAS_MILVUS_ISOLATE=true
# Optional later (multi-worker): MAS_MILVUS_URI=http://127.0.0.1:19530
# --- Alibaba DashScope embeddings (中英多语) ---
# Console / API key: https://bailian.console.aliyun.com/  →  API-KEY
# How-to: https://help.aliyun.com/zh/model-studio/get-api-key
# Embedding API: https://help.aliyun.com/zh/model-studio/text-embedding-synchronous-api
DASHSCOPE_API_KEY=
DASHSCOPE_EMBEDDING_MODEL=text-embedding-v4
DASHSCOPE_EMBEDDING_DIMENSION=1024
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# Never reuse a 384-dim Lite DB with DashScope 1024-dim vectors.
MAS_RAG_TOP_K=5
MAS_RAG_TENANT_ID=default
# When true, analyze fails if referenced documents are not index-ready
MAS_RAG_REQUIRE_READY=false
MAS_RAG_INDEX_LEASE_SECONDS=300
# Embedding resilience (DashScope / remote providers)
MAS_EMBEDDING_MAX_RETRIES=3
MAS_EMBEDDING_BACKOFF_SECONDS=0.5
MAS_EMBEDDING_TIMEOUT_SECONDS=60
# Optional keyword-score floor (0=off). Hybrid RRF scores are not filtered by this.
MAS_RAG_MIN_SCORE=0
MAS_RAG_DEGRADE_ON_VECTOR_ERROR=true
MAS_RAG_SANITIZE_HITS=true
# Lexical rerank (candidates → top_k). Offline-safe; no cross-encoder required.
MAS_RAG_RERANK_ENABLED=true
MAS_RAG_RERANK_CANDIDATES=20
# Async index worker queue (only when POST /documents/index async_mode=true AND Redis set)
# See Service / persistence for MAS_REDIS_* reliable-queue settings.
# MAS_REDIS_URL=
# --- CI / offline unit-test override (applied automatically by run_tests.py) ---
# MAS_RAG_INDEX_MODE=sync_on_run
# MAS_EMBEDDING_PROVIDER=deterministic
# MAS_EMBEDDING_DIMENSION=384
# MAS_MILVUS_URI=data/milvus_lite_ci.db
MAS_CRITIC_MAX_ITERATIONS=2
# Company profile LLM calls per company (0=skip, 1=default, max 3 including rewrite retries)
MAS_PROFILE_LLM_MAX_ATTEMPTS=1

# Quant tool transport: production = local. mcp = optional stdio for AST ratio demos only
# (does NOT move Retrieval/RAG/SEC onto MCP).
MAS_TOOL_BACKEND=local

# MCP document-search sidecar only (mcp_layer/data/docs). NOT production upload PDF RAG.
# Production evidence RAG: MAS_RAG_* + DocumentIndexer — see docs/RAG_MILVUS.md / docs/MCP.md
# auto | keyword | milvus
MAS_MCP_DOC_SEARCH=keyword

# Market data — primary + fallback with TTL cache
MAS_MARKET_DATA_PROVIDER=alphavantage
MAS_MARKET_DATA_FALLBACK=yahoo
# Yahoo fallback uses the yfinance library (already in dependencies), not raw Yahoo HTTP API.
MAS_MARKET_CACHE_TTL_SECONDS=60
# Free key: https://www.alphavantage.co/support/#api-key
ALPHAVANTAGE_API_KEY=

# ---------------------------------------------------------------------------
# Service / persistence
# ---------------------------------------------------------------------------
MAS_HOST=127.0.0.1
MAS_PORT=8000
MAS_OUTPUT_DIR=outputs
MAS_UPLOAD_DIR=uploads
MAS_DB_PATH=data/lumenfin.db
# PostgreSQL-first: required for APP_ENV=production|integration.
# Local recommended: docker compose Postgres (see docker-compose.yml).
# Unit-test backend: SQLite (APP_ENV=test). Dev SQLite needs MAS_ALLOW_SQLITE_DEV=true.
MAS_DATABASE_URL=postgresql+psycopg://mas_user:CHANGE_ME@localhost:5432/lumenfin
# Optional queue/checkpoint infrastructure
# MAS_REDIS_URL=redis://localhost:6379/0
MAS_REDIS_QUEUE_NAME=finance-analysis
MAS_REDIS_INDEX_QUEUE_NAME=rag-document-index
# Reliable Redis delivery (pending/processing/dead-letter)
MAS_REDIS_JOB_MAX_ATTEMPTS=3
MAS_REDIS_RECLAIM_IDLE_SECONDS=30
MAS_REDIS_RETRY_BACKOFF_SECONDS=1
# Provider resilience (max_*_ATTEMPTS = total attempts including first call)
# MAS_LLM_MAX_ATTEMPTS=3
# MAS_EMBEDDING_MAX_ATTEMPTS=3
MAS_ANALYSIS_DEADLINE_SECONDS=120
MAS_INDEX_JOB_DEADLINE_SECONDS=180
MAS_LLM_MAX_INFLIGHT_PER_PROCESS=8
MAS_EMBEDDING_MAX_INFLIGHT_PER_PROCESS=4
MAS_MARKET_DATA_MAX_INFLIGHT_PER_PROCESS=8
MAS_PROVIDER_ACQUIRE_TIMEOUT_SECONDS=5
# Required by the production docker-compose stack; do not use example values.
POSTGRES_USER=mas_user
POSTGRES_DB=lumenfin
POSTGRES_PASSWORD=
NEO4J_PASSWORD=
# MAS_NEO4J_URI=bolt://localhost:7687
# MAS_NEO4J_USERNAME=neo4j
# MAS_NEO4J_PASSWORD=

# ---------------------------------------------------------------------------
# Cross-repository release gate
# ---------------------------------------------------------------------------
# Optional when repositories are cloned as siblings.
# LUMENFIN_ROOT=
# FINAGENTBENCH_DIR=
# Released benchmark contract; CI may override only for manual validation.
FINAGENTBENCH_REF=v0.1.0-rc.1
FINAGENTBENCH_PROFILE=ci
