# Phase 3.2B integration defaults (not production secrets).
# Copy to .env.integration if you need local overrides; do not commit real passwords.

COMPOSE_PROJECT_NAME=lumenfin-it
POSTGRES_DB=lumenfin_integration
POSTGRES_USER=lumenfin_it
POSTGRES_PASSWORD=lumenfin_it_pass
POSTGRES_PORT=5433
REDIS_PORT=6380
MILVUS_PORT=19531
API_A_PORT=18080
API_B_PORT=18081

MAS_REDIS_INDEX_QUEUE_NAME=rag-document-index-it
MAS_MILVUS_COLLECTION=lumenfin_chunks_it
MAS_RAG_INDEX_LEASE_SECONDS=5
MAS_REDIS_JOB_MAX_ATTEMPTS=3
MAS_REDIS_RECLAIM_IDLE_SECONDS=5
MAS_REDIS_RETRY_BACKOFF_SECONDS=1
